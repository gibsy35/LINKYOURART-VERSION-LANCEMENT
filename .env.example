
# Gemini API Configuration
GEMINI_API_KEY=

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Resend Mail Delivery Configuration
# Get your API key from https://resend.com/api-keys
# Domain must be verified in https://resend.com/domains first (DKIM/SPF)
RESEND_API_KEY=

# ── Legacy (no longer used in production, kept for server.ts local dev) ──
# SMTP Mail Delivery Configuration (OVH) — replaced by Resend above because
# the OVH shared relay had no DKIM signing and shared IP reputation across
# all OVH customers, causing emails to land in spam.
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=587
# SMTP_USER=contact@linkyourart.com
# SMTP_PASS=votre_mot_de_passe_ovh
# SMTP_FROM="LinkYourArt" <contact@linkyourart.com>
