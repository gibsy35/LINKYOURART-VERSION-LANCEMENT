rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = tout utilisateur connecté avec un email reconnu
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'linkyourart@gmail.com' ||
        request.auth.token.email == 'lequimejeanbaptiste@gmail.com' ||
        request.auth.token.email == 'jeanbaptistelequime@gmail.com' ||
        request.auth.token.email == 'lequimejeanbaptiste@gmail.com' ||
        request.auth.token.email == 'linkart@gmail.com' ||
        request.auth.token.email == 'contact@linkyourart.com' ||
        request.auth.token.email == 'admin@linkyourart.com'
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── USERS ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      // L'utilisateur voit son propre profil, l'admin voit tout
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Tout utilisateur peut créer son profil à l'inscription
      allow create: if isSignedIn();
      // Mise à jour : soi-même ou admin
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── PUBLIC STATS (compteur pré-inscription) ─────────────────────────────
    match /public_stats/{docId} {
      allow read: if true;
      allow write: if true; // public counter — must be writable by everyone
    }

    // ── PRE-REGISTRATIONS ──────────────────────────────────────────────────
    match /pre_registrations/{docId} {
      allow create: if true; // anyone can pre-register
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.email == request.auth.token.email || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── ACCESS TOKENS ──────────────────────────────────────────────────────
    match /access_tokens/{token} {
      allow read: if true; // public check at signup
      allow create, update, delete: if isSignedIn();
    }

    // ── DEMO REQUESTS ──────────────────────────────────────────────────────
    match /demo_requests/{docId} {
      allow create: if true;
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── VERIFICATION REQUESTS ──────────────────────────────────────────────
    match /verification_requests/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ── VALIDATION REQUESTS ────────────────────────────────────────────────
    match /validation_requests/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── GOVERNANCE ─────────────────────────────────────────────────────────
    match /governance_votes/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /governance_proposals/{docId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── MÉCÉNAT ACQUISITIONS ───────────────────────────────────────────────
    match /mecenat_acquisitions/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── SUPPORT APPLICATIONS ───────────────────────────────────────────────
    match /support_applications/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── PROJECTS ───────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /projects_pending/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ── CONTRACTS ─────────────────────────────────────────────────────────
    match /contracts/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /contract_attachments/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── MESSAGES ──────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.fromId == request.auth.uid ||
        resource.data.toId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.fromId == request.auth.uid || isAdmin()
      );
    }

    match /messages_sent/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid || isAdmin()
      );
    }

    // ── WATCHLIST / SWIPE ─────────────────────────────────────────────────
    match /watchlists/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /swipe_likes/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── PRESS ─────────────────────────────────────────────────────────────
    match /press_applications/{docId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    match /press_accreditations/{docId} {
      allow create: if true;
      allow read, update: if isAdmin();
    }

    // ── MISC ──────────────────────────────────────────────────────────────
    match /admin_keys/{docId} {
      allow read, write: if isAdmin();
    }

    match /milestones/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
    }

    match /audit_requests/{docId} {
      allow create: if true;
      allow read: if isSignedIn();
    }

    match /saved_articles/{docId} {
      allow create: if isSignedIn();
      allow read, delete: if isSignedIn();
    }

    match /governance/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /service_requests/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.fromId == request.auth.uid || isAdmin()
      );
    }

    match /mentorship_sessions/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.mentorId == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
    }

    // ── TEST CONNECTION ────────────────────────────────────────────────────
    match /test/{docId} {
      allow read, write: if true;
    }

    // ── FALLBACK ADMIN ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
